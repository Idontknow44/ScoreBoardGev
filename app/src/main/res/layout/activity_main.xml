<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:background="@color/screen_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- את הרכיבים שלכם מוסיפים כאן, בין שתי התגיות -->

    <!-- title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="League Results"
        android:textColor="#ff6750a4"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:text="START" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@color/team_a_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvNameA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Eagles"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="0"
                android:textStyle="bold"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tvErrorMsA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/red"
                android:textSize="10sp"
                android:layout_marginBottom="56dp"/>

            <Button
                android:id="@+id/btnA3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+3"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnA2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+2"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnA1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+1"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnAM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="-1"
                android:backgroundTint="@color/special_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/team_b_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvNameB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Lions"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="0"
                android:textStyle="bold"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tvErrorMsB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/red"
                android:textSize="10sp"
                android:layout_marginBottom="56dp"/>

            <Button
                android:id="@+id/btnB3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+3"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnB2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+2"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnB1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+1"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnBM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-1"
                android:padding="12dp"
                android:backgroundTint="@color/special_button"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal|bottom"
        android:baselineAligned="false">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="0dp"
            android:backgroundTint="@color/btn_reset"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="RESET"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnEndGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:backgroundTint="@color/btn_end_game"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="END GAME"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

</LinearLayout>